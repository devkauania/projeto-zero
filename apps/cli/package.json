{
  "name": "@projeto-zero/cli",
  "version": "1.1.3",
  "description": "CLI scaffolder and swarm launcher for Claude Code agent workspaces",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "projeto-zero": "dist/index.js",
    "antigravity": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "cli",
    "scaffold",
    "claude",
    "claude-code",
    "anthropic",
    "mcp",
    "subagent",
    "agents",
    "wizard",
    "clack"
  ],
  "author": "Projeto Zero",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devkauania/projeto-zero.git"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-seed.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "commander": "^13.1.0",
    "conf": "^13.1.0",
    "figlet": "^1.8.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
